      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${OURS_APP_URL}/*",
        "backchannel.logout.url": "${OURS_APP_URL}/logout/connect/back-channel/keycloak",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      }
    }
