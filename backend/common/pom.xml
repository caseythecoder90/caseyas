<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.ours</groupId>
    <artifactId>ours-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>common</artifactId>
  <name>Ours common</name>
  <description>Documents, repositories, Flamingock change classes, and shared contracts for api and worker.</description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.flamingock</groupId>
        <artifactId>flamingock-community-bom</artifactId>
        <version>${flamingock.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>

    <!-- Flamingock: versioned change classes, audited history in Mongo, distributed lock.
         Narrow modules rather than flamingock-community, which also pulls Couchbase, DynamoDB, and SQL. -->
    <dependency>
      <groupId>io.flamingock</groupId>
      <artifactId>flamingock-springboot-integration</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flamingock</groupId>
      <artifactId>flamingock-mongodb-sync-targetsystem</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flamingock</groupId>
      <artifactId>flamingock-mongodb-sync-auditstore</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <!-- Generates the change registry at compile time from the @Change classes. -->
            <path>
              <groupId>io.flamingock</groupId>
              <artifactId>flamingock-processor</artifactId>
              <version>${flamingock.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
